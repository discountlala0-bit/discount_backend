generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  firebaseUid   String    @unique @map("firebase_uid")
  phoneNumber   String    @unique @map("phone_number")
  email         String?   @unique
  password      String?
  name          String?
  hasBooklet    Boolean   @default(false) @map("has_booklet")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  image         String?   @map("image")
  referralCode  String?   @unique @map("referral_code")
  referredBy    String?   @map("referred_by")
  role          String    @default("user")
  isActive      Boolean   @default(true) @map("is_active")
  deactivatedAt DateTime? @map("deactivated_at")

  carts             Cart[]
  orders            Order[]
  userCoupons       UserCoupon[]
  referralsMade     ReferralLog[] @relation("Referrer")
  referralsReceived ReferralLog[] @relation("ReferredUser")

  @@map("users")
}

model City {
  id        String    @id @default(uuid())
  name      String    @unique
  state     String
  country   String    @default("India")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  booklets  Booklet[]
  addOns    AddOn[]
  places    Place[]

  @@map("cities")
}

model Booklet {
  id                String            @id @default(uuid())
  cityId            String            @map("city_id")
  title             String
  description       String?
  price             Float
  validity          Int               @default(365)
  image             String?
  status            String            @default("active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  city              City              @relation(fields: [cityId], references: [id], onDelete: Cascade)
  bookletOffers     BookletOffer[]
  bookletCategories BookletCategory[]

  @@map("booklets")
}

model Offer {
  id                 String         @id @default(uuid())
  title              String
  description        String?
  price              Float
  validity           Int?
  timing             String?
  placeId            String         @map("place_id")
  offerType          String         @default("add_on") @map("offer_type")
  status             String         @default("active")
  termsAndConditions String?        @map("terms_and_conditions")
  popularity         Int            @default(0)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  place              Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  bookletOffers      BookletOffer[]
  addOnOffers        AddOnOffer[]
  userCoupons        UserCoupon[]

  @@map("offers")
}

model BookletOffer {
  id        String  @id @default(uuid())
  bookletId String  @map("booklet_id")
  offerId   String  @map("offer_id")
  quantity  Int     @default(1)
  booklet   Booklet @relation(fields: [bookletId], references: [id], onDelete: Cascade)
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([bookletId, offerId])
  @@map("booklet_offers")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id       String @id @default(uuid())
  cartId   String @map("cart_id")
  itemType String @map("item_type")
  itemId   String @map("item_id")
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@map("cart_items")
}

model Order {
  id              String       @id @default(uuid())
  userId          String       @map("user_id")
  totalAmount     Float        @map("total_amount")
  discountAmount  Float        @default(0) @map("discount_amount")
  status          String       @default("pending")
  distributorId   String?      @map("distributor_id")
  referralApplied Boolean      @default(false) @map("referral_applied")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id])
  distributor     Distributor? @relation(fields: [distributorId], references: [id])
  items           OrderItem[]
  payments        Payment[]

  @@map("orders")
}

model OrderItem {
  id       String @id @default(uuid())
  orderId  String @map("order_id")
  itemType String @map("item_type")
  itemId   String @map("item_id")
  price    Float
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  paymentStatus String   @default("pending") @map("payment_status")
  paymentMethod String?  @map("payment_method")
  transactionId String?  @map("transaction_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model UserCoupon {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  offerId         String    @map("offer_id")
  status          String    @default("active")
  redeemCode      String?   @unique @map("redeem_code")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  redeemedAt      DateTime? @map("redeemed_at")
  isBookletOrigin Boolean   @default(false) @map("is_booklet_origin")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer           Offer     @relation(fields: [offerId], references: [id])

  @@map("user_coupons")
}

model ReferralLog {
  id             String   @id @default(uuid())
  referrerId     String   @map("referrer_id")
  referredUserId String   @map("referred_user_id")
  rewardStatus   String   @default("pending") @map("reward_status")
  createdAt      DateTime @default(now()) @map("created_at")
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id])
  referredUser   User     @relation("ReferredUser", fields: [referredUserId], references: [id])

  @@unique([referrerId, referredUserId])
  @@map("referral_logs")
}

model Distributor {
  id                 String   @id @default(uuid())
  name               String
  phone              String   @unique
  email              String?  @unique
  referralCode       String   @unique @map("referral_code")
  discountAmount     Float    @default(0) @map("discount_amount")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  orders             Order[]

  @@map("distributors")
}

model Category {
  id                String            @id @default(uuid())
  name              String            @unique
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  bookletCategories BookletCategory[]
  addOnCategories   AddOnCategory[]
  places            Place[]

  @@map("categories")
}

model Place {
  id          String   @id @default(uuid())
  name        String
  cityId      String?  @map("city_id")
  categoryId  String   @map("category_id")
  address     String?
  phone       String?
  description String?
  image       String?
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  city        City?    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  offers      Offer[]

  @@map("places")
}

model BookletCategory {
  id         String   @id @default(uuid())
  bookletId  String   @map("booklet_id")
  categoryId String   @map("category_id")
  booklet    Booklet  @relation(fields: [bookletId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([bookletId, categoryId])
  @@map("booklet_categories")
}

model AddOn {
  id              String          @id @default(uuid())
  cityId          String          @map("city_id")
  title           String
  description     String?
  price           Float
  image           String?
  status          String          @default("active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  city            City            @relation(fields: [cityId], references: [id], onDelete: Cascade)
  addOnOffers     AddOnOffer[]
  addOnCategories AddOnCategory[]

  @@map("add_ons")
}

model AddOnOffer {
  id       String @id @default(uuid())
  addOnId  String @map("add_on_id")
  offerId  String @map("offer_id")
  quantity Int    @default(1)
  addOn    AddOn  @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([addOnId, offerId])
  @@map("add_on_offers")
}

model AddOnCategory {
  id         String   @id @default(uuid())
  addOnId    String   @map("add_on_id")
  categoryId String   @map("category_id")
  addOn      AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([addOnId, categoryId])
  @@map("add_on_categories")
}

model Banner {
  id           String   @id @default(uuid())
  image        String
  redirectType String   @map("redirect_type")
  redirectId   String?  @map("redirect_id")
  priority     Int      @default(0)
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("banners")
}
